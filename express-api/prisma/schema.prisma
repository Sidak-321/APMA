generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(uuid())
  email      String     @unique
  password   String
  isVerified Boolean    @default(false)
  createdAt  DateTime   @default(now())
  projects   Project[]
  documents  Document[]
  agentRuns  AgentRun[]
  otpCodes   OtpCode[]
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id          String     @id @default(uuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents   Document[]
  agentRuns   AgentRun[]
}

model Document {
  id         String   @id @default(uuid())
  projectId  String
  userId     String
  filename   String
  fileType   String
  chunkCount Int      @default(0)
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])
}

model AgentRun {
  id               String   @id @default(uuid())
  projectId        String
  userId           String
  goal             String
  outputType       String
  status           String   @default("running")
  outputJson       Json?
  guardrailsPassed Boolean  @default(false)
  confidenceScore  Float?
  tokensUsed       Int?
  latencyMs        Int?
  langsmithRunId   String?
  userFeedback     String?
  createdAt        DateTime @default(now())
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id])
}